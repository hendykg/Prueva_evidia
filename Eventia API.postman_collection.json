                }
              ]
            },
            "description": "Búsqueda y categoría combinadas."
          },
          "response": []
        },
        {
          "name": "Detalle de evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));\npm.test('Incluye isAttending con token', () => pm.expect(pm.response.json()).to.have.property('isAttending'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
