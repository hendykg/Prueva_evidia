              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "1"
              ]
            },
            "description": "Sin token el detalle no incluye `isAttending`."
          },
          "response": []
        }
      ],
      "description": "Categorías y eventos. Las peticiones guardan ids en variables para usarlos en las siguientes."
